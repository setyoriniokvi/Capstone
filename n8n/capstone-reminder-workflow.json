              "name": "target",
              "value": "={{ $json.recipient }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "countryCode",
              "value": "62"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
